+++ b/tests/test_cogos_home.py
@@ -0,0 +1,149 @@
+"""Tests for the COGOS_HOME runtime-state relocation feature.
+
+The runtime state directory is currently hardcoded under ``~/.cogos`` in
+several places.  These tests pin down the required behaviour:
+
+* a single, centralized resolver decides the base directory,
+* ``COGOS_HOME`` relocates that base directory,
+* when ``COGOS_HOME`` is unset the default stays ``~/.cogos``,
+* the known call sites (feishu config, lm-service config, phone default
+  config, agent loop default dir) all go through the resolver.
+"""
+
+import importlib
+import os
+from pathlib import Path
+
+import pytest
+
+
+# ── centralized resolver ──────────────────────────────────────────────
+
+
+class TestCogosHomeResolver:
+    def test_default_is_dot_cogos(self, monkeypatch):
+        monkeypatch.delenv("COGOS_HOME", raising=False)
+        from cogos.home import cogos_home
+
+        assert cogos_home() == Path.home() / ".cogos"
+
+    def test_env_var_relocates_base(self, monkeypatch, tmp_path):
+        target = tmp_path / "relocated"
+        monkeypatch.setenv("COGOS_HOME", str(target))
+        from cogos.home import cogos_home
+
+        assert cogos_home() == target
+
+    def test_env_var_expanduser(self, monkeypatch):
+        monkeypatch.setenv("COGOS_HOME", "~/custom-cogos-home")
+        from cogos.home import cogos_home
+
+        assert cogos_home() == Path.home() / "custom-cogos-home"
+
+    def test_empty_env_var_falls_back_to_default(self, monkeypatch):
+        monkeypatch.setenv("COGOS_HOME", "")
+        from cogos.home import cogos_home
+
+        assert cogos_home() == Path.home() / ".cogos"
+
+    def test_returns_path(self, monkeypatch, tmp_path):
+        monkeypatch.setenv("COGOS_HOME", str(tmp_path))
+        from cogos.home import cogos_home
+
+        assert isinstance(cogos_home(), Path)
+
+
+# ── call sites honour COGOS_HOME ──────────────────────────────────────
+
+
+class TestFeishuConfigUsesCogosHome:
+    def test_feishu_home_relocated(self, monkeypatch, tmp_path):
+        target = tmp_path / "cogos-home"
+        monkeypatch.setenv("COGOS_HOME", str(target))
+        from cogos.feishu import config
+
+        importlib.reload(config)
+        try:
+            assert config.Config.FEISHU_HOME == target / "feishu"
+            assert config.Config.GLOBAL_PATH == target / "feishu" / "global.json"
+            assert config.Config.ACCOUNTS_DIR == target / "feishu" / "accounts"
+        finally:
+            monkeypatch.delenv("COGOS_HOME", raising=False)
+            importlib.reload(config)
+
+    def test_feishu_home_default(self, monkeypatch):
+        monkeypatch.delenv("COGOS_HOME", raising=False)
+        from cogos.feishu import config
+
+        importlib.reload(config)
+        assert config.Config.FEISHU_HOME == Path.home() / ".cogos" / "feishu"
+
+
+class TestLmServiceConfigUsesCogosHome:
+    def test_config_dir_relocated(self, monkeypatch, tmp_path):
+        target = tmp_path / "cogos-home"
+        monkeypatch.setenv("COGOS_HOME", str(target))
+        from cogos.lm_service import config
+
+        importlib.reload(config)
+        try:
+            assert config.CONFIG_DIR == target / "lm-service"
+            assert config.CONFIG_FILE == target / "lm-service" / "config.yaml"
+            assert config.SECRETS_FILE == target / "lm-service" / "secrets.yaml"
+            assert config.STATE_FILE == target / "lm-service" / "state.yaml"
+        finally:
+            monkeypatch.delenv("COGOS_HOME", raising=False)
+            importlib.reload(config)
+
+    def test_config_dir_default(self, monkeypatch):
+        monkeypatch.delenv("COGOS_HOME", raising=False)
+        from cogos.lm_service import config
+
+        importlib.reload(config)
+        assert config.CONFIG_DIR == Path.home() / ".cogos" / "lm-service"
+
+
+class TestPhoneDefaultConfigUsesCogosHome:
+    def test_default_config_path_relocated(self, monkeypatch, tmp_path):
+        target = tmp_path / "cogos-home"
+        monkeypatch.setenv("COGOS_HOME", str(target))
+        from cogos.phone import term
+
+        importlib.reload(term)
+        try:
+            assert term._default_config_path() == str(
+                target / "phone" / "default" / "phone.json"
+            )
+        finally:
+            monkeypatch.delenv("COGOS_HOME", raising=False)
+            importlib.reload(term)
+
+    def test_default_config_path_default(self, monkeypatch):
+        monkeypatch.delenv("COGOS_HOME", raising=False)
+        from cogos.phone import term
+
+        importlib.reload(term)
+        assert term._default_config_path() == str(
+            Path.home() / ".cogos" / "phone" / "default" / "phone.json"
+        )
+
+
+class TestAgentLoopDefaultDirUsesCogosHome:
+    def test_agent_dir_default_relocated(self, monkeypatch, tmp_path):
+        target = tmp_path / "cogos-home"
+        monkeypatch.setenv("COGOS_HOME", str(target))
+        from cogos.agent import loop
+
+        importlib.reload(loop)
+        try:
+            assert loop._default_agent_dir() == target / "agent" / "tangyu"
+        finally:
+            monkeypatch.delenv("COGOS_HOME", raising=False)
+            importlib.reload(loop)
+
+    def test_agent_dir_default(self, monkeypatch):
+        monkeypatch.delenv("COGOS_HOME", raising=False)
+        from cogos.agent import loop
+
+        importlib.reload(loop)
+        assert loop._default_agent_dir() == Path.home() / ".cogos" / "agent" / "tangyu"

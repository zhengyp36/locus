new file mode 100644
index 0000000..22adcbc
--- /dev/null
+++ b/cogos/home.py
@@ -0,0 +1,24 @@
+"""Centralized resolution of the COGOS runtime state directory.
+
+The runtime state lives under ``~/.cogos`` by default.  Setting the
+``COGOS_HOME`` environment variable relocates that base directory.  All
+call sites should resolve their paths through :func:`cogos_home` so there
+is a single source of truth.
+"""
+
+import os
+from pathlib import Path
+
+DEFAULT_COGOS_HOME = Path.home() / ".cogos"
+
+
+def cogos_home() -> Path:
+    """Return the base runtime state directory.
+
+    Honours the ``COGOS_HOME`` environment variable (with ``~`` expansion);
+    falls back to ``~/.cogos`` when it is unset or empty.
+    """
+    value = os.environ.get("COGOS_HOME")
+    if value:
+        return Path(value).expanduser()
+    return DEFAULT_COGOS_HOME
